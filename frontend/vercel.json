{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/st/track.js", "destination": "https://umami-analytics-e0d9.onrender.com/script.js" },
    { "source": "/st/api/send", "destination": "https://umami-analytics-e0d9.onrender.com/api/send" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/logo.png", "destination": "/logo.png" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/logo-128.webp", "destination": "/logo-128.webp" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
