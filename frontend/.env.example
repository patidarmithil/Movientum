# Frontend environment variables (Phase 3.5A)
# Copy to .env and fill values

# API endpoints
VITE_API_URL=http://localhost:8000
VITE_API_URL_SECONDARY=https://movientum-backend-secondary.onrender.com

# Google Sign-In (GIS ID-token flow, no client secret)
# Get client ID from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Umami analytics
VITE_UMAMI_WEBSITE_ID=your_umami_website_id
VITE_UMAMI_SCRIPT=/st/track.js
